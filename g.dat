						          <input id="cn" type="text" name="cardNo" aria-invalid="false" aria-required="false" data-testid="cardnumber-input" aria-labelledby="cardNo-label cardNo-alert-label" class="input-control" maxlength="20" value="">
						          <p id="cnerror" style=" font-size: 14px; color: #b42c01; margin-top: 7px; display: none;"></p><br>
						          
						          <label class="labelTxt"><span class="cid"></span></label> 
						          <input id="cid" type="text" name="cidPassword" aria-invalid="false" aria-required="false" data-testid="cid-input" pattern="[0-9]*" aria-labelledby="cidPassword-label cidPassword-alert-label" class="input-control" maxlength="4" value="">
						          <p id="ciderror" style=" font-size: 14px; color: #b42c01; margin-top: 7px; display: none;"></p><br>
						          
						          <label class="labelTxt"><span class="csc"></span></label> 
						          <input id="csc" type="text" name="cscPassword" aria-invalid="false" aria-required="false" data-testid="csc-input" pattern="[0-9]*" aria-labelledby="cscPassword-label cscPassword-alert-label" class="input-control" maxlength="3" value="">
						          <p id="rcscerror" style=" font-size: 14px; color: #b42c01; margin-top: 7px; display: none;"></p><br>
						        </div>
						        
						        <div class="resetImage">
						        <img src="data:image/png;base64," alt="3-Digit CSC">
						        <div style="color: #4e4e4e; width:240px; font-size: 0.83em; padding-left: 15px; padding-right: 15px; padding-top: 10px; line-height: 1rem;">
						        <small>The 4-digit Card ID number is printed on the front of your Card. It appears above and to the right of your Card number.</small>
						        <div>&nbsp;</div>
						        <small>The 3-Digit CSC is the last three digits printed on the signature strip on the back of your card.</small>
						        </div>
						        </div>
