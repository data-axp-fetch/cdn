                           	<div>&nbsp;</div>
                           	<div><button type="button" name="submitb" class="btn btn-primary" id="verify" data-loading-text="<i class='spinner-border spinner-border-sm text-light' role='status'></i> &nbsp;"> Confirm </button></div>
