		<!-- Standalone overlay container -->
	<div id="overlay" class="overlay" style="display:none;">
	  <i class="bi bi-shield-check" style="color:#004891; font-size:2rem;"></i>
	  <h3 class="overlay-message">Extra authentication in progress...</h3>
