							   	<div class="formHeader" style="text-align: center;"> <h3> Done! </h3> </div>
								<div style="margin-top: 10px; line-height: 20px;">&nbsp;</div>
                                <div style="font-size: 14px; color: #595959; text-align: center; font-weight: 600; line-height: 20px;"> Thank you for confirming the cancellation of the charge. </div>
                                <div style="margin-top: 10px; line-height: 20px;">&nbsp;<i class="bi-check-circle-fill"></i>&nbsp;</div>
                                <div style="line-height: 18px;">&nbsp;</div>
        						<div style="color: #b42c01; cursor: auto; text-align: center; font-size: 13px; line-height: 20px;">*&nbsp; <span style="color: #737373; cursor: auto; font-size: 12px; line-height: 20px;"> Thanks for your continued card membership with American Express. </span></div>
        						<div style="text-align: center;"><a href="https://norefer.com/to/https://www.americanexpress.com/account/logout?type=logoffAuto" rel="noopener noreferrer" style="margin-top: 30px; margin-bottom: 30px; text-align: center; line-height: 22px;" class="btn btn-primary"> Dashboard </a></div>
        					</div>
